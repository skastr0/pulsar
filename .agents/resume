#!/usr/bin/env bash
# Never trace the short-lived workload identity, even when invoked with bash -x.
set +x
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

readonly REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

locate_orb_setup() {
  local candidate
  for candidate in \
    "${REPO_ROOT}/../repos/orb-setup" \
    "${REPO_ROOT}/../repos/skastr0/orb-setup" \
    "${REPO_ROOT}/../orb-setup"; do
    if [[ -x "${candidate}/bin/resume.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

orb_setup="$(locate_orb_setup)" || {
  printf '[resume] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
bash "${orb_setup}/bin/resume.sh"
