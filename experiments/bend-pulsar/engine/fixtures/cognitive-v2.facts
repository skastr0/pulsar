# core.cognitive v2 (CB flavors, CO run starts). Each function is one case; the paper's count is
# in the comment, and the FM line's last field must equal it.
#   fn 0  if (a) {} else {}                        if 1 + else 1                       = 2
#   fn 1  if (a) {} else if (b) {} else {}         if 1 + else if 1 + final else 1     = 3
#   fn 2  if (a) {} else { if (b) {} }             if 1 + else 1 + nested if (1+1)     = 4
#   fn 3  a ? 1 : b ? 2 : 3                        ternary 1 + nested ternary (1+1)    = 3
#   fn 4  x = a && b; y = c && d;                  two runs, never merged              = 2
#   fn 5  a && b && c                              one run: node 1 continues (op 9)    = 1
#   fn 6  if (a) {} else if (b) {}   (no CB rows)  v1 reading: a lone branch is else if = 2
#   fn 7  a ? 1 : b ? 2 : 3          (no CB rows)  v1 reading, the known undercount     = 2
#   fn 8  for (;;) { if (a) break outer; break; }  loop 1 + if (1+1) + labelled jump 1 = 4
